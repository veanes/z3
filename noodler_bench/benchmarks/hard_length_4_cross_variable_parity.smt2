(set-logic ALL)
(declare-fun x () String)
(declare-fun y () String)

;; x \in (a^4)*
(define-fun a4 () (RegEx String) (str.to_re "aaaa"))
(assert (str.in_re x (re.* a4)))

;; y \in (b^6)*
(define-fun b6 () (RegEx String) (str.to_re "bbbbbb"))
(assert (str.in_re y (re.* b6)))

;; Constraint: |x| + 2 = |y|
(assert (= (+ (str.len x) 2) (str.len y)))

;; Wait, if x=4 (so m=1), then |x|+2 = 6, which matches y=6 (n=1). This is SAT!
;; Let's make it structurally impossible via parity:
(declare-fun z () String)
(declare-fun w () String)

(assert (str.in_re z (re.* a4)))
(assert (str.in_re w (re.* b6)))

;; We demand: |z| + 1 = |w|
;; Since |z| is a multiple of 4 (even), |z| + 1 is strictly ODD.
;; But |w| is a multiple of 6 (which is strictly EVEN).
;; An odd number cannot equal an even number!
(assert (= (+ (str.len z) 1) (str.len w)))

;; Why it is hard:
;; "Cross-Variable Parity Arithmetic"
;; The integer solver has no native idea what lengths are generated by (a^4)* and (b^6)*.
;; Through the CEGAR loop, both \Sigma^a abstractions are queried and fed back dynamically.
;; The arithmetic theory ends up evaluating that 4m + 1 = 6n. 
;; Linear integer arithmetic (using GCD / extended Euclidean algorithms internally) deduces
;; that 6n - 4m = 1 is unsolvable (GCD of 6 and 4 is 2, which does not divide 1). 
;; Tests combining the structural regex extraction with deeply proven Diophantine equations!
(check-sat)